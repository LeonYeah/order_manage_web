FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/node:18-bullseye-slim AS build

WORKDIR /app

COPY mall-admin-web/package*.json ./
RUN npm config set registry https://registry.npmmirror.com \
    && npm install

COPY mall-admin-web/ ./
RUN npm run build

FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/nginx:alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
